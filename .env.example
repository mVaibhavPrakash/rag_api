# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=
# Serverless spec used when auto-creating the index (optional)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ── Embedding settings (optional — defaults shown) ────────────────────────────
# Must match the dimension of your Pinecone index.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Retriever settings (optional — defaults shown) ────────────────────────────
# Chat model used by the RAG generator and grader nodes.
LLM_MODEL=gpt-4o-mini

# Number of chunks returned by each retriever (BM25 + dense) before RRF fusion.
TOP_K=5

# EnsembleRetriever alpha: weight assigned to the dense (Pinecone) retriever.
#   0.0 = pure BM25 (keyword-only)
#   1.0 = pure dense (semantic-only)
#   0.6 = recommended default (60% semantic, 40% keyword)
HYBRID_ALPHA=0.6

# Maximum number of query-rewrite attempts before the graph falls back to
# generating an answer from whatever was retrieved.
MAX_REWRITES=2

# Optional custom system prompt for the generator LLM.
# SYSTEM_PROMPT=You are a helpful assistant...
